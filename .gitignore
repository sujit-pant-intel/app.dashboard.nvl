# ── Sensitive collateral data — keep folder structure, ignore contents ────────
shared/etest/*
shared/material/*
!shared/etest/.gitkeep
!shared/material/.gitkeep
!shared/material/*.py


# ── Large vendored JS — checked in (offline-safe), no secrets ────────────────
# shared/library/plotly-*.js  ← intentionally tracked

# ── Runtime / pipeline outputs ───────────────────────────────────────────────
**/.cache/
**/output*/
**/reports/
**/heatmap/
**/data/raw/
**/data/programs/
correlation-analysis/pipeline_timing.log
correlation-analysis/.last_dir
correlation-analysis/.pcm_lot_cache.json

# ── Python artifacts ──────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyd
*.pdb

# ── .NET build output / vendored package extraction ──────────────────────────
**/bin/
**/obj/
**/extracted/

# ── Stray backups (editor/manual copies) ──────────────────────────────────────
*.bak
*.bak[0-9]
* - ORIG.*
* - Copy.*

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.code-workspace

# ── Zip archives (exports/temp) ───────────────────────────────────────────────
*.zip
